<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Direct (GitHub DMG) and local dev builds: Developer ID / Apple Development signed,
  hardened runtime, NOT sandboxed.

  The hardened runtime blocks the microphone unless this entitlement is present, so
  without it voice memos silently fail (the 1.0.2 DMG shipped without it).

  application-groups: the App Group the widget extension reads its privacy-safe snapshot
  from. Team-prefixed (<team id>.<app bundle id>), which Developer ID / Apple Development
  signed Mac apps may use without a provisioning profile. The packaging scripts rewrite the
  value for QA bundle ids (oj_prepare_entitlements), so a QA build never shares the real group.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>WWC5HJN6AL.com.eplisium.omega-journal</string>
    </array>
</dict>
</plist>

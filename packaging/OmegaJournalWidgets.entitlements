<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  WidgetKit extension (Contents/PlugIns/OmegaJournalWidgets.appex), every channel.

  - app-sandbox: required; macOS refuses to load an unsandboxed widget extension.
  - application-groups: read the snapshot the app writes. Same group as the app
    (<team id>.<app bundle id>); oj_prepare_entitlements rewrites it for QA bundle ids.

  Deliberately nothing else: no network, no file access, no keychain. The widget only
  reads one small JSON file of counts from the group container.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.application-groups</key>
    <array>
        <string>WWC5HJN6AL.com.eplisium.omega-journal</string>
    </array>
</dict>
</plist>

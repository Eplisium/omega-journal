<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store build (scripts/make_mas.sh). App Sandbox ON.

  - files.user-selected.read-write: import/export, backup folder, attachments via open/save panels.
  - files.bookmarks.app-scope: remember a user-chosen backup folder across launches.
  - device.audio-input: voice memos (WritingAudio.swift).
  - print: ExportManager.printEntry opens the system print panel.
  - application-identifier / team-identifier / keychain-access-groups must match the
    embedded Mac App Store provisioning profile (WWC5HJN6AL.com.eplisium.omega-journal).
    make_mas.sh's dev/dry-run mode strips these three keys because they need a profile.

  Deliberately NO network entitlements: the app never talks to a server.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.print</key>
    <true/>
    <key>com.apple.application-identifier</key>
    <string>WWC5HJN6AL.com.eplisium.omega-journal</string>
    <key>com.apple.developer.team-identifier</key>
    <string>WWC5HJN6AL</string>
    <key>keychain-access-groups</key>
    <array>
        <string>WWC5HJN6AL.com.eplisium.omega-journal</string>
    </array>
</dict>
</plist>
